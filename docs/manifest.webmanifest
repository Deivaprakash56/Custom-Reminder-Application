{
  "name": "Reminders",
  "short_name": "Reminders",
  "description": "Reminders, to-dos, a task board and notes with a voice assistant. Works offline; your data stays on this device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0d13",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New reminder", "short_name": "New", "url": "./?action=new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Voice assistant", "short_name": "Voice", "url": "./?action=voice", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today", "url": "./?action=today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "./?action=calendar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
